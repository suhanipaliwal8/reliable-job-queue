# Settings the app reads (see src/jobqueue/config.py).
# NOTE: jobqueue reads real environment variables, not this file. Use it as
# documentation; `export JQ_DB_PASSWORD=...` (or `set` on Windows) to apply a value.
JQ_DB_HOST=127.0.0.1
JQ_DB_PORT=3307
JQ_DB_USER=jobqueue
JQ_DB_PASSWORD=jobqueue_pw
JQ_DB_NAME=jobqueue

# The test suite uses this database instead (name must end with _test).
JQ_TEST_DB_NAME=jobqueue_test